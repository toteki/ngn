# How pedantic does jebberwocky think each of these signals is?
var jabberwockyInputDetail:int = 8
var jabberwockyOrientDetail:int = 7
var jabberwockyQuantifyDetail:int = 7
var jabberwockySpecifyDetail:int = 7
