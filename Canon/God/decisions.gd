class_name Decisions extends Node

# Settings object. Use the one stored in God.decisions

# Range 0-9, with 9 being mute. How concise is the main log?
var jabberwockyFilter:int = 3

# Toggle. Do logs also go to console?
var jabberwockyDev:bool = true

# How important does jabberwocky think each of these signals is?
var jabberwockyLvInput:int = 2
var jabberwockyLvOrient:int = 3
var jabberwockyLvQuantify:int = 3
var jabberwockyLvSpecify:int = 3
